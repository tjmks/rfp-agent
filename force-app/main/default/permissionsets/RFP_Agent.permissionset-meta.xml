<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- App Launcher access -->
    <applicationVisibilities>
        <application>RFP_App</application>
        <visible>true</visible>
    </applicationVisibilities>

    <label>RFP Agent</label>
    <description>Grants access to all RFP Agent objects, fields, Apex classes, and LWC components. Also requires the org's Prompt Builder execution permission for AI processing.</description>

    <!-- Object permissions -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
        <object>RFP__c</object>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
        <object>Extraction_Profile__c</object>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
        <object>Extraction_Question__c</object>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
        <object>Extraction_Result__c</object>
    </objectPermissions>

    <!-- Field permissions: RFP__c -->
    <fieldPermissions><editable>true</editable><field>RFP__c.Account__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>RFP__c.Extraction_Profile__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>RFP__c.Opportunity__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>RFP__c.Overall_Confidence__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>RFP__c.Processing_Error__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>RFP__c.Processing_Status__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>RFP__c.Source_Document_Id__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>RFP__c.Status__c</field><readable>true</readable></fieldPermissions>

    <!-- Field permissions: Extraction_Profile__c -->
    <fieldPermissions><editable>true</editable><field>Extraction_Profile__c.Description__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Extraction_Profile__c.Is_Default__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Extraction_Profile__c.Grounding_Context__c</field><readable>true</readable></fieldPermissions>
