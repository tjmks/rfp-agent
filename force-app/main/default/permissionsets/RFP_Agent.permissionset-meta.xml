    <fieldPermissions><editable>true</editable><field>Extraction_Question__c.Question_Text__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Extraction_Question__c.Sort_Order__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Extraction_Question__c.Target_Field_API_Name__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Extraction_Question__c.Category__c</field><readable>true</readable></fieldPermissions>
