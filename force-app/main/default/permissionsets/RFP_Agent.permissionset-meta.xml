    <fieldPermissions><editable>true</editable><field>Extraction_Result__c.Review_Status__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Extraction_Result__c.Sort_Order__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Extraction_Result__c.Target_Field_API_Name__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>false</editable><field>Extraction_Result__c.Category__c</field><readable>true</readable></fieldPermissions>

    <!-- Apex class access -->
    <classAccesses>
        <apexClass>RFPController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RFPExtractionAction</apexClass>
